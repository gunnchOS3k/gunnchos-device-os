{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gunnchos.golden_journey_quality_scorecard.v1",
  "title": "Golden Journey Quality Scorecard",
  "type": "object",
  "required": [
    "schema",
    "journey_id",
    "FUNCTIONAL_PASS",
    "PRODUCT_QUALITY_SCORE",
    "INDEPENDENT_VERIFICATION",
    "PHYSICAL_PENDING",
    "HUMAN_VALIDATION_PENDING",
    "claim_boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "gunnchos.golden_journey_quality_scorecard.v1"
    },
    "journey_id": {
      "type": "string",
      "pattern": "^GOLDEN-(0[1-9]|10)$"
    },
    "severity": {
      "type": "string",
      "enum": ["S0", "S1", "S2", "S3"]
    },
    "work_packet": {
      "type": "string"
    },
    "FUNCTIONAL_PASS": {
      "description": "Whether supporting digital functional checks for this journey currently pass. Not independent verification.",
      "type": "object",
      "required": ["status", "authority"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "authority": {
          "type": "string",
          "enum": [
            "implementer_supporting_harness",
            "independent_verifier",
            "unset"
          ]
        },
        "evidence_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "PRODUCT_QUALITY_SCORE": {
      "description": "0–4 dimension scores per PRODUCT_QUALITY_GATE. user_preference stays NOT_MEASURED without humans.",
      "type": "object",
      "required": ["dimensions", "authority"],
      "additionalProperties": false,
      "properties": {
        "authority": {
          "type": "string",
          "enum": [
            "implementer_draft",
            "independent_verifier",
            "human_study",
            "unset"
          ]
        },
        "dimensions": {
          "type": "object",
          "required": [
            "correctness",
            "reliability",
            "latency_perceived_performance",
            "visual_quality",
            "interaction_quality",
            "discoverability",
            "consistency",
            "accessibility",
            "error_recovery",
            "user_preference"
          ],
          "additionalProperties": false,
          "properties": {
            "correctness": { "$ref": "#/$defs/score_cell" },
            "reliability": { "$ref": "#/$defs/score_cell" },
            "latency_perceived_performance": { "$ref": "#/$defs/score_cell" },
            "visual_quality": { "$ref": "#/$defs/score_cell" },
            "interaction_quality": { "$ref": "#/$defs/score_cell" },
            "discoverability": { "$ref": "#/$defs/score_cell" },
            "consistency": { "$ref": "#/$defs/score_cell" },
            "accessibility": { "$ref": "#/$defs/score_cell" },
            "error_recovery": { "$ref": "#/$defs/score_cell" },
            "user_preference": { "$ref": "#/$defs/score_cell" }
          }
        },
        "average_excluding_not_measured": {
          "type": ["number", "null"]
        },
        "notes": { "type": "string" }
      }
    },
    "INDEPENDENT_VERIFICATION": {
      "description": "Filled only by the independent verifier after their own acceptance plan. Implementer must leave status PENDING/NOT_CLAIMED.",
      "type": "object",
      "required": ["status", "evidence_level_claimed", "depth_level_claimed"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_CLAIMED",
            "PENDING",
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "evidence_level_claimed": {
          "type": ["string", "null"],
          "enum": [null, "E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8"]
        },
        "depth_level_claimed": {
          "type": ["string", "null"],
          "enum": [null, "D0", "D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8"]
        },
        "verifier_plan_path": {
          "type": "string"
        },
        "verifier_result_path": {
          "type": ["string", "null"]
        },
        "notes": { "type": "string" }
      }
    },
    "PHYSICAL_PENDING": {
      "type": "object",
      "required": ["pending", "target_evidence_level"],
      "additionalProperties": false,
      "properties": {
        "pending": { "const": true },
        "target_evidence_level": { "const": "E5" },
        "notes": { "type": "string" }
      }
    },
    "HUMAN_VALIDATION_PENDING": {
      "type": "object",
      "required": ["pending", "target_evidence_level"],
      "additionalProperties": false,
      "properties": {
        "pending": { "const": true },
        "target_evidence_level": { "const": "E6" },
        "notes": { "type": "string" }
      }
    },
    "supporting_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase_xi_journey_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unit_or_integration_tests": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fixture_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "disclaimer": {
          "type": "string",
          "description": "Must state supporting evidence is not independent verification."
        }
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "summary", "status"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["S0", "S1", "S2", "S3"] },
          "summary": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["OPEN", "FIXED", "BACKLOG", "WONTFIX"]
          },
          "evidence": { "type": "string" }
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "required": [
        "independent_verification_claimed",
        "physically_validated",
        "human_validated",
        "frontier_parity_claimed"
      ],
      "additionalProperties": false,
      "properties": {
        "independent_verification_claimed": { "const": false },
        "physically_validated": { "const": false },
        "human_validated": { "const": false },
        "frontier_parity_claimed": { "const": false }
      }
    },
    "updated_at": { "type": "string" },
    "updated_by": { "type": "string" }
  },
  "$defs": {
    "score_cell": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "description": "Integer 0–4, or NOT_MEASURED for human-only dimensions.",
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 4 },
            { "const": "NOT_MEASURED" }
          ]
        },
        "notes": { "type": "string" }
      }
    }
  }
}
