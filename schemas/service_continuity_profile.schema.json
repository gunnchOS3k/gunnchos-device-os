{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gunnchos.service_continuity_profile.v1",
  "title": "Service-continuity profile bundle",
  "type": "object",
  "required": [
    "schema",
    "thesis",
    "rq",
    "claim_boundary",
    "shipping_os",
    "physical_boot",
    "research_classes",
    "continuity_levels",
    "profiles"
  ],
  "properties": {
    "schema": { "const": "gunnchos.service_continuity_profile.v1" },
    "shipping_os": { "const": false },
    "physical_boot": { "const": false },
    "STANDARDIZED_6G": { "const": false },
    "research_classes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "enum": ["desk", "mobile-docked", "local-creation", "wearable"]
      }
    },
    "continuity_levels": {
      "type": "array",
      "items": {
        "enum": ["target", "degraded", "min_useful", "failed"]
      }
    },
    "profiles": { "type": "object" }
  }
}
