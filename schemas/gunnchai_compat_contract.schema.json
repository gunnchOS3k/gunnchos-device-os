{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gunnchos.gunnchai_compat_contract.v1",
  "title": "gunnchAI3k ↔ device-os versioned compatibility contract",
  "type": "object",
  "required": [
    "schema",
    "contract_version",
    "evidence_class",
    "claim_boundary",
    "device_os",
    "gunnchai",
    "api_surface",
    "device_os_assumptions",
    "coupling_policy"
  ],
  "properties": {
    "schema": { "const": "gunnchos.gunnchai_compat_contract.v1" },
    "evidence_class": { "enum": ["ACCEPTED_MAIN", "PREVIEW_DRAFT"] },
    "device_os": {
      "type": "object",
      "required": ["repo", "accepted_main_sha", "integration_module"],
      "properties": {
        "accepted_main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "merged_pr": { "type": "integer", "minimum": 1 }
      }
    },
    "gunnchai": {
      "type": "object",
      "required": ["repo", "accepted_main_sha", "owner_artifacts"],
      "properties": {
        "accepted_main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "merged_pr": { "type": "integer", "minimum": 1 },
        "owner_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "device_os_assumptions": {
      "type": "object",
      "required": [
        "GUNNCHAI_APP_PRODUCT_COMPLETE",
        "GUNNCHAI_DIGITAL_PRODUCT_CAPABILITY_PASS",
        "HUMAN_E6"
      ]
    },
    "coupling_policy": {
      "type": "object",
      "required": ["explicit_pin_file", "blocks_device_os_ci"],
      "properties": {
        "blocks_device_os_ci": { "const": false }
      }
    }
  }
}
