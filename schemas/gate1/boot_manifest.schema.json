{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gunnchos.local/schemas/gate1/boot_manifest.schema.json",
  "title": "gunnchOS Boot Manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "image_id",
    "image_arch",
    "target_class",
    "services",
    "health_checks",
    "storage",
    "display",
    "network",
    "created_at"
  ],
  "properties": {
    "manifest_version": {
      "type": "string"
    },
    "image_id": {
      "type": "string"
    },
    "image_arch": {
      "type": "string",
      "enum": [
        "x86_64",
        "amd64",
        "aarch64",
        "arm64",
        "armv7l",
        "host"
      ]
    },
    "target_class": {
      "type": "string",
      "enum": [
        "host-native",
        "vm-container",
        "physical-candidate"
      ]
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "health_checks": {
      "type": "array"
    },
    "storage": {
      "type": "object",
      "required": [
        "min_free_mb"
      ],
      "properties": {
        "min_free_mb": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "display": {
      "type": "object"
    },
    "network": {
      "type": "object"
    },
    "stale_after_days": {
      "type": "integer"
    },
    "created_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
