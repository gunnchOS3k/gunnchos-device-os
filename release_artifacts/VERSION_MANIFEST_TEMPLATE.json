{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gunnchOS Version Manifest",
  "description": "Template only — not yet generated by build pipeline",
  "type": "object",
  "required": [
    "product",
    "version",
    "build_id",
    "channel",
    "gate",
    "created_at",
    "supported_device_classes",
    "artifacts",
    "claim_boundary"
  ],
  "properties": {
    "product": {
      "type": "string",
      "const": "gunnchOS-device-layer"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+",
      "example": "0.1.0-rc.1"
    },
    "build_id": {
      "type": "string",
      "example": "20260621.1"
    },
    "channel": {
      "type": "string",
      "enum": ["stable", "beta", "dev", "school_managed"]
    },
    "gate": {
      "type": "string",
      "enum": ["alpha", "beta", "release_candidate", "ga_release", "field_pilot", "production_release"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "supported_device_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["student_14_5", "handheld_hybrid", "ds_xl_coder", "wearables_arena_set"]
      }
    },
    "minimum_os": {
      "type": "object",
      "properties": {
        "windows_build": { "type": "string", "example": "22621" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer" },
          "kind": {
            "type": "string",
            "enum": ["installer", "bundle", "recovery", "sbom", "checksums", "release_notes"]
          }
        }
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "algorithm": { "type": "string", "example": "ed25519" },
          "key_id": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "previous_version": {
      "type": "string",
      "description": "For rollback chain"
    },
    "claim_boundary": {
      "type": "object",
      "properties": {
        "allowed_claims": { "type": "array", "items": { "type": "string" } },
        "forbidden_claims": { "type": "array", "items": { "type": "string" } },
        "not_shipping_yet": { "type": "boolean", "default": true }
      }
    }
  },
  "example": {
    "product": "gunnchOS-device-layer",
    "version": "0.0.0-template",
    "build_id": "template",
    "channel": "dev",
    "gate": "alpha",
    "created_at": "2026-06-21T00:00:00Z",
    "supported_device_classes": ["student_14_5", "ds_xl_coder"],
    "artifacts": [],
    "claim_boundary": {
      "allowed_claims": ["user-focused OS alpha"],
      "forbidden_claims": ["GA release", "finished shipping OS"],
      "not_shipping_yet": true
    }
  }
}
