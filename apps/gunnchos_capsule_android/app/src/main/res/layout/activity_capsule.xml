<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/capsule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <android.webkit.WebView
        android:id="@+id/capsule_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B1220" />

    <LinearLayout
        android:id="@+id/capsule_startup_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B1220"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/capsule_brand_mark"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/capsule_brand_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="gunnchOS"
            android:textColor="#3DDC84"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/capsule_startup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Starting Capsule…"
            android:textColor="#E8EEF7"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/capsule_startup_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#9BB0C9"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/capsule_failure_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/capsule_retry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Retry" />

            <Button
                android:id="@+id/capsule_diagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Diagnostics" />

            <Button
                android:id="@+id/capsule_exit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Exit to Android" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
