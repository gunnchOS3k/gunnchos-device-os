{
  "schema": "gunnchos.media_focus_policy.v1",
  "duck_on_notification_db": -6.0,
  "pause_on_call": true,
  "resume_after_call": true,
  "ai_tts_obeys_focus": true,
  "screen_blank_prevent_during_video": true,
  "media_keys": [
    "play_pause",
    "next",
    "prev",
    "stop",
    "mute",
    "volume_up",
    "volume_down"
  ]
}
