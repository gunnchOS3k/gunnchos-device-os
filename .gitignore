# WP-013 release engineering: build staging scratch (regenerated by
# `gunnchctl os-image build`) and the default gunnchSDK runtime install
# root (regenerated by `gunnchctl install`/`gunnchctl sdk test`). Only the
# BUILD_MANIFEST.json + rootfs.tar.gz evidence under artifacts/ is tracked.
os_build/realm_images/*/stage/
os_build/sdk_runtime/
artifacts/phase_xii/models/*.gguf
artifacts/phase_xii/llama-server.log
artifacts/phase_xii/llama-server.pid
artifacts/phase_xii/rj_wave0_run.log
artifacts/phase_xii/rj_run*.log

# Stage 2 generated sysroots / images / prove outputs (rebuildable)
artifacts/stage2/**
!artifacts/stage2/.gitkeep

# Phase XIV prove scratch (keep authoritative reports)
artifacts/phase_xiv/**
!artifacts/phase_xiv/OS_PROVE_REPORT.json
!artifacts/phase_xiv/STAGE2_REPROOF.json
!artifacts/phase_xiv/.gitkeep

# Phase XV prove scratch (keep authoritative reports + handheld NPI)
artifacts/phase_xv/**
!artifacts/phase_xv/OS_PROVE_REPORT.json
!artifacts/phase_xv/HANDHELD_32G_HEADROOM.json
!artifacts/phase_xv/NPI_DEFECT-STORAGE-HANDHELD-32G.json
!artifacts/phase_xv/.gitkeep

# Device Lab runtime instances / evidence (regenerated by gunnchctl)
artifacts/device_lab/

# Stage 2 local signing material (never commit)
os_build/stage2/keys/

# WP-011R / Device Lab interactive guest runtime (qcow2, cache, work, sockets)
# Keep provisioned disks on disk for WP-011R; never commit to WP-013.
os_build/device_lab_interactive_guest/artifacts/*.qcow2
os_build/device_lab_interactive_guest/cache/
os_build/device_lab_interactive_guest/work/
artifacts/wp011r/**/*.qcow2
artifacts/wp011r/**/*.sock
artifacts/wp011r/**/edk2-*-vars.fd
artifacts/wp011r/interactive_guest_session/
artifacts/wp011r/ring/qemu-ring/
