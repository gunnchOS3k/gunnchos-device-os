{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gunnchos.middleware.ring_input.v1",
  "title": "gunnchOS Ring Input Event Envelope",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "target_app",
    "gesture",
    "confidence",
    "ts_utc",
    "SILICON_EXACT_EMULATION",
    "PHYSICAL_RING_E6",
    "claim_boundary"
  ],
  "properties": {
    "schema": { "const": "gunnchos.middleware.ring_input.v1" },
    "event_id": { "type": "string", "minLength": 4 },
    "target_app": { "type": "string", "minLength": 1 },
    "gesture": {
      "type": "string",
      "enum": ["tap", "swipe", "hold", "point", "cancel", "text_inject"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "payload": { "type": "object" },
    "ts_utc": { "type": "string", "minLength": 10 },
    "SILICON_EXACT_EMULATION": { "const": false },
    "PHYSICAL_RING_E6": { "type": "boolean" },
    "claim_boundary": { "type": "string", "minLength": 16 }
  },
  "additionalProperties": false
}
