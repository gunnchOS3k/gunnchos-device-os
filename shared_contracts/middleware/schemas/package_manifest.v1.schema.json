{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gunnchos.middleware.package_manifest.v1",
  "title": "gunnchOS Package Manifest (SDK app_manifest mirror)",
  "type": "object",
  "required": [
    "schema",
    "app_id",
    "name",
    "version",
    "api_version",
    "min_os_version",
    "arch_targets",
    "entrypoint",
    "permissions",
    "capabilities_required",
    "sandbox_profile"
  ],
  "properties": {
    "schema": { "const": "gunnchos.sdk.app_manifest.v1" },
    "app_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.\\-]{2,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "api_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "min_os_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "max_os_version": { "type": ["string", "null"] },
    "arch_targets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["aarch64", "x86_64", "wasm32"] }
    },
    "entrypoint": { "type": "string", "minLength": 1 },
    "permissions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "capabilities_required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": { "type": "array" },
    "sandbox_profile": {
      "type": "object",
      "required": ["network_policy"],
      "properties": {
        "network_policy": { "type": "string" },
        "filesystem_scope": { "type": "string" },
        "allow_ipc": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "runtime": { "type": "string", "enum": ["python", "godot"] },
    "stub_content": { "type": "boolean" },
    "source": { "type": "string" },
    "platform001": { "type": "boolean" },
    "godot": { "type": "object" }
  },
  "additionalProperties": true
}
