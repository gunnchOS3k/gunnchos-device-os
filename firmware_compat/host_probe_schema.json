{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gunnchOS Host Firmware Probe Output",
  "type": "object",
  "required": [
    "device_id",
    "host_os",
    "host_environment",
    "probe_version",
    "claim_boundary",
    "probes",
    "timestamp"
  ],
  "properties": {
    "device_id": { "type": "string" },
    "host_os": { "type": "string", "enum": ["linux", "darwin", "windows", "unknown"] },
    "host_environment": { "type": "boolean" },
    "profile_source": { "type": "string" },
    "fixture_path": { "type": ["string", "null"] },
    "probe_version": { "type": "string" },
    "claim_boundary": { "type": "string" },
    "timestamp": { "type": "string" },
    "probes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "simulated"],
        "properties": {
          "status": { "type": "string", "enum": ["pass", "warn", "fail", "skip"] },
          "simulated": { "type": "boolean" },
          "message": { "type": "string" },
          "indicators": { "type": "object" }
        }
      }
    }
  }
}
