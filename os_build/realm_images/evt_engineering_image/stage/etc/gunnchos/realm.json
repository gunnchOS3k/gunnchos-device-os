{
  "claim_boundary": "EVT realm for hardware bring-up / validation. Signed with DEV keys only, anti-rollback counter enforced, no production keys or real eSIM/factory credentials present.",
  "debug_access": {
    "enabled": true,
    "methods": [
      "ssh",
      "serial_console",
      "gunnchctl_debug_bridge"
    ],
    "requires_unlock": true
  },
  "description": "Engineering Validation Test (EVT) build: closer to shippable than the lab guest, still fully debuggable, used for bring-up and hardware validation.",
  "developer_mode": {
    "enabled": true,
    "persists_across_updates": false,
    "unlock_policy": "fused_unlock_flag"
  },
  "factory_only_services": [],
  "logging": {
    "level": "INFO",
    "redaction_required": true,
    "remote_upload": true,
    "retention_days": 30
  },
  "packages": {
    "excluded": [
      "gunnchos.dev.python_toolchain",
      "gunnchos.factory.calibration_import",
      "gunnchos.factory.esim_provisioning"
    ],
    "included": [
      "gunnchos.core.hal",
      "gunnchos.core.input",
      "gunnchos.core.ring",
      "gunnchos.core.display",
      "gunnchos.core.dock",
      "gunnchos.core.continuity",
      "gunnchos.core.identity",
      "gunnchos.core.permissions",
      "gunnchos.core.sandbox",
      "gunnchos.core.connectivity",
      "gunnchos.core.ai_interface",
      "gunnchos.core.profile_manager",
      "gunnchos.core.a11y",
      "gunnchos.core.diagnostics",
      "gunnchos.core.updater",
      "gunnchos.core.recovery",
      "gunnchos.dev.ssh_shell",
      "gunnchos.dev.gunnchctl",
      "gunnchos.evt.hardware_validation_suite",
      "gunnchos.evt.telemetry_debug_agent"
    ]
  },
  "production_restrictions": {
    "adb_equivalent": "unlock_gated",
    "allow_unsigned_updates": false,
    "debug_access_allowed": true,
    "root_access": "unlock_gated",
    "shell_access": "unlock_gated"
  },
  "realm_id": "EVT_ENGINEERING_IMAGE",
  "recovery_behavior": {
    "auto_recovery_on_boot_failure": true,
    "factory_reset_available": true,
    "recovery_partition_required": true
  },
  "schema": "gunnchos.image_realm.v1",
  "secrets_policy": {
    "allowed_secret_classes": [
      "dev_test_only",
      "evt_bench_credentials"
    ],
    "forbidden": [
      "production_signing_key",
      "production_device_identity",
      "real_esim_credential"
    ]
  },
  "status": "ACTIVE_DEV",
  "telemetry": {
    "enabled": true,
    "opt_out_supported": false,
    "scope": "engineering_only"
  },
  "trust_roots": {
    "anti_rollback_enforced": true,
    "key_source": "dev",
    "production_private_keys_present": false,
    "signing_keys": [
      "release_engineering_ed25519_dev"
    ]
  },
  "update_channel": "evt"
}
