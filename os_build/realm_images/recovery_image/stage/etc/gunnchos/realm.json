{
  "claim_boundary": "RECOVERY_IMAGE is the last-resort boot target. Anti-rollback enforced, no dev shell by default, no production keys. Validated only through virtual/simulated boot-failure and rollback tests in this repo, not on physical hardware.",
  "debug_access": {
    "enabled": false,
    "methods": [
      "serial_console_readonly"
    ],
    "requires_unlock": true
  },
  "description": "Minimal recovery-partition image: boot-failure fallback, factory reset, update rollback, diagnostic bundle export, secure wipe. Intentionally tiny attack surface.",
  "developer_mode": {
    "enabled": false,
    "persists_across_updates": false,
    "unlock_policy": "fused_unlock_flag"
  },
  "factory_only_services": [],
  "logging": {
    "level": "WARN",
    "redaction_required": true,
    "remote_upload": false,
    "retention_days": 7
  },
  "packages": {
    "excluded": [
      "gunnchos.core.ai_interface",
      "gunnchos.core.ring",
      "gunnchos.core.dock",
      "gunnchos.dev.ssh_shell",
      "gunnchos.dev.python_toolchain",
      "gunnchos.factory.esim_provisioning"
    ],
    "included": [
      "gunnchos.recovery.minimal_init",
      "gunnchos.recovery.ab_rollback_agent",
      "gunnchos.recovery.factory_reset",
      "gunnchos.recovery.diagnostic_bundle_export",
      "gunnchos.recovery.secure_wipe",
      "gunnchos.recovery.user_data_migration"
    ]
  },
  "production_restrictions": {
    "adb_equivalent": "disabled",
    "allow_unsigned_updates": false,
    "debug_access_allowed": false,
    "root_access": "unlock_gated",
    "shell_access": "disabled"
  },
  "realm_id": "RECOVERY_IMAGE",
  "recovery_behavior": {
    "auto_recovery_on_boot_failure": true,
    "factory_reset_available": true,
    "recovery_partition_required": true
  },
  "schema": "gunnchos.image_realm.v1",
  "secrets_policy": {
    "allowed_secret_classes": [
      "dev_test_only"
    ],
    "forbidden": [
      "production_signing_key",
      "production_device_identity",
      "real_esim_credential"
    ]
  },
  "status": "ACTIVE_DEV",
  "telemetry": {
    "enabled": false,
    "opt_out_supported": true,
    "scope": "none"
  },
  "trust_roots": {
    "anti_rollback_enforced": true,
    "key_source": "dev",
    "production_private_keys_present": false,
    "signing_keys": [
      "release_engineering_ed25519_dev"
    ]
  },
  "update_channel": "recovery"
}
