{
  "claim_boundary": "DEV_LAB realm for interactive engineering work. Full debug access, no telemetry upload, no production keys ever present. Not a shippable image.",
  "debug_access": {
    "enabled": true,
    "methods": [
      "ssh",
      "serial_console",
      "gunnchctl_debug_bridge",
      "remote_python_repl"
    ],
    "requires_unlock": false
  },
  "description": "Interactive lab guest for day-to-day gunnchOS service development inside the Device Lab (QEMU/hybrid). Maximum introspection, no restrictions.",
  "developer_mode": {
    "enabled": true,
    "persists_across_updates": true,
    "unlock_policy": "always_on"
  },
  "factory_only_services": [],
  "logging": {
    "level": "DEBUG",
    "redaction_required": false,
    "remote_upload": false,
    "retention_days": 14
  },
  "packages": {
    "excluded": [
      "gunnchos.factory.calibration_import",
      "gunnchos.factory.esim_provisioning"
    ],
    "included": [
      "gunnchos.core.hal",
      "gunnchos.core.input",
      "gunnchos.core.ring",
      "gunnchos.core.display",
      "gunnchos.core.dock",
      "gunnchos.core.continuity",
      "gunnchos.core.identity",
      "gunnchos.core.permissions",
      "gunnchos.core.sandbox",
      "gunnchos.core.connectivity",
      "gunnchos.core.ai_interface",
      "gunnchos.core.profile_manager",
      "gunnchos.core.a11y",
      "gunnchos.core.diagnostics",
      "gunnchos.dev.updater_debug",
      "gunnchos.dev.recovery_debug",
      "gunnchos.dev.fleet_agent_stub",
      "gunnchos.dev.ssh_shell",
      "gunnchos.dev.python_toolchain",
      "gunnchos.dev.gunnchctl",
      "gunnchos.dev.gunnchsdk"
    ]
  },
  "production_restrictions": {
    "adb_equivalent": "enabled",
    "allow_unsigned_updates": true,
    "debug_access_allowed": true,
    "root_access": "enabled",
    "shell_access": "unrestricted"
  },
  "realm_id": "DEVICE_LAB_INTERACTIVE_DEVELOPMENT_GUEST",
  "recovery_behavior": {
    "auto_recovery_on_boot_failure": false,
    "factory_reset_available": true,
    "recovery_partition_required": false
  },
  "schema": "gunnchos.image_realm.v1",
  "secrets_policy": {
    "allowed_secret_classes": [
      "dev_test_only"
    ],
    "forbidden": [
      "production_signing_key",
      "production_device_identity",
      "real_esim_credential"
    ]
  },
  "status": "ACTIVE_DEV",
  "telemetry": {
    "enabled": false,
    "opt_out_supported": true,
    "scope": "none"
  },
  "trust_roots": {
    "anti_rollback_enforced": false,
    "key_source": "dev",
    "production_private_keys_present": false,
    "signing_keys": [
      "release_engineering_ed25519_dev"
    ]
  },
  "update_channel": "dev-lab"
}
