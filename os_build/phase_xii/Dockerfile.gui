FROM debian:bookworm-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    weston xwayland xvfb chromium libreoffice-writer libreoffice-calc libreoffice-impress \
    ffmpeg mpv cups-client wireguard-tools git python3 python3-pip python3-venv \
    curl ca-certificates fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/gunnchos
COPY . /opt/gunnchos/device-os
ENV REAL_APP_EXECUTION_MODE=ACTIVE
CMD ["python3", "device-os/scripts/run_phase_xii_rj.py"]
