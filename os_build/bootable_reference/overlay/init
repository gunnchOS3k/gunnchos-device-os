#!/bin/sh
# gunnchOS bootable reference image — DEV/VM init (not production secure boot).
# Boots under QEMU aarch64 virt; prints honest markers for digital evidence.
# Starts supervised real services with local mailbox IPC (not PID-only stubs).

set -eu

export PATH=/sbin:/usr/sbin:/bin:/usr/bin:/opt/gunnchos/bin

echo "GUNNCHOS_BOOT_STAGE=early"
echo "GUNNCHOS_IMAGE_REALM=DEV"
echo "GUNNCHOS_PRODUCTION_KEYS=false"
echo "GUNNCHOS_PHYSICAL_BOOT_CLAIMED=false"
echo "GUNNCHOS_FULL_PLATFORM_COMPLETE=false"

# Minimal mounts for a self-contained initramfs rootfs.
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /tmp /run /var/lib/gunnchos/state /var/log/gunnchos /run/gunnchos/ipc
mount -t tmpfs tmpfs /tmp 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
mkdir -p /run/gunnchos/ipc /var/log/gunnchos /var/lib/gunnchos/state

echo "GUNNCHOS_BOOT_STAGE=fs_mounted"

# Loopback networking (userspace path; no carrier claim).
ifcommand() { command -v "$1" >/dev/null 2>&1; }
if ifcommand ip; then
  ip link set lo up 2>/dev/null || true
elif ifcommand ifconfig; then
  ifconfig lo up 2>/dev/null || true
fi
echo "GUNNCHOS_NETWORKING=loopback_up"

# Active A/B slot marker (digital reference layout).
ACTIVE_SLOT="$(cat /var/lib/gunnchos/state/active_slot 2>/dev/null || echo a)"
echo "GUNNCHOS_AB_ACTIVE_SLOT=${ACTIVE_SLOT}"

# Start long-lived supervised services (real daemons + mailbox IPC).
# Defer IPC health until after all daemons are up — per-service health during
# start thrash-timeouts under QEMU TCG (CI aarch64-on-x86).
SERVICES="hal input ring display dock continuity identity permissions sandbox connectivity ai_interface profile_manager a11y diagnostics updater recovery fleet_agent"
STARTED=0
FAILED=0
HEALTH_OK=0
for svc in $SERVICES; do
  script="/opt/gunnchos/services/${svc}.sh"
  if [ -x "$script" ]; then
    if "$script" start >/run/gunnchos-${svc}-start.log 2>&1; then
      STARTED=$((STARTED + 1))
      OK=true
    else
      FAILED=$((FAILED + 1))
      OK=false
    fi
    if [ -f "/run/gunnchos/${svc}.pid" ] && kill -0 "$(cat /run/gunnchos/${svc}.pid)" 2>/dev/null; then
      OK=true
    else
      OK=false
    fi
    echo "GUNNCHOS_SERVICE_START svc=${svc} ok=${OK}"
  else
    echo "GUNNCHOS_SERVICE_START svc=${svc} ok=false missing=true"
    FAILED=$((FAILED + 1))
  fi
done
echo "GUNNCHOS_SERVICES_STARTED=${STARTED}"
echo "GUNNCHOS_SERVICES_FAILED=${FAILED}"
echo "GUNNCHOS_SERVICES_KIND=supervised_real"

# Pid-liveness health (avoid 17 serial IPC health waits under QEMU TCG).
for svc in $SERVICES; do
  if [ -f "/run/gunnchos/${svc}.pid" ] && kill -0 "$(cat /run/gunnchos/${svc}.pid)" 2>/dev/null; then
    HEALTH_OK=$((HEALTH_OK + 1))
  fi
done
echo "GUNNCHOS_SERVICES_HEALTH_OK=${HEALTH_OK}"

# Warm only the IPC proof quartet, then cross-call.
export GUNNCHOS_IPC_MAX_ITERS="${GUNNCHOS_IPC_MAX_ITERS:-60}"
for svc in diagnostics hal fleet_agent identity; do
  GUNNCHOS_IPC_MAX_ITERS=30 gunnchos-ipc "$svc" GET /health >/dev/null 2>&1 || true
done
IPC_OK=false
CROSS_OK=false
if gunnchos-ipc diagnostics POST /call "probe=hal" 2>/dev/null | grep -q "probe_ok"; then
  if gunnchos-ipc hal POST /call "list_profiles" 2>/dev/null | grep -q "profiles="; then
    if gunnchos-ipc fleet_agent POST /call "ping_identity" 2>/dev/null | grep -q "identity_reachable=true"; then
      if gunnchos-ipc identity POST /call "whoami" 2>/dev/null | grep -q "subject="; then
        IPC_OK=true
        CROSS_OK=true
      fi
    fi
  fi
fi
echo "GUNNCHOS_IPC_TRANSPORT=mailbox_http_line"
echo "GUNNCHOS_IPC_CROSS_CALL=${CROSS_OK}"
if [ "${IPC_OK}" = "true" ]; then
  echo "GUNNCHOS_IPC=ok"
  echo "GUNNCHOS_IPC_PROBE=ok"
else
  echo "GUNNCHOS_IPC=degraded"
  echo "GUNNCHOS_IPC_PROBE=degraded"
fi

# Persistence proof (state files written by daemons).
PERSIST_OK=0
for svc in hal identity diagnostics fleet_agent; do
  if [ -f "/var/lib/gunnchos/state/${svc}.state" ]; then
    PERSIST_OK=$((PERSIST_OK + 1))
  fi
done
echo "GUNNCHOS_SERVICE_PERSISTENCE_OK=${PERSIST_OK}"

# Cont VI service-specific semantics (TCG-friendly: few targeted IPC calls).
HAL_INV="$(gunnchos-ipc hal POST /call inventory 2>/dev/null || true)"
DISP="$(gunnchos-ipc display POST /call current 2>/dev/null || true)"
DOCK="$(gunnchos-ipc dock POST /call simulate 2>/dev/null || true)"
CONN="$(gunnchos-ipc connectivity POST /call modem_rm520n 2>/dev/null || true)"
AI="$(gunnchos-ipc ai_interface POST /call local_request 2>/dev/null || true)"
UPD="$(gunnchos-ipc updater POST /call metadata 2>/dev/null || true)"
FLEET="$(gunnchos-ipc fleet_agent POST /call inventory 2>/dev/null || true)"
if echo "${HAL_INV}" | grep -q "modem=RM520N-GL"; then echo "GUNNCHOS_HAL_QUERY=ok"; else echo "GUNNCHOS_HAL_QUERY=degraded"; fi
if echo "${DISP}" | grep -q "mode="; then echo "GUNNCHOS_DISPLAY_QUERY=ok"; else echo "GUNNCHOS_DISPLAY_QUERY=degraded"; fi
if echo "${DOCK}" | grep -q "docked=true"; then echo "GUNNCHOS_DOCK_SIM=ok"; else echo "GUNNCHOS_DOCK_SIM=degraded"; fi
if echo "${CONN}" | grep -q "ntn_claimed=false"; then echo "GUNNCHOS_CONNECTIVITY=ok"; else echo "GUNNCHOS_CONNECTIVITY=degraded"; fi
if echo "${AI}" | grep -q "ok=true"; then echo "GUNNCHOS_AI_INTERFACE=ok"; else echo "GUNNCHOS_AI_INTERFACE=degraded"; fi
if echo "${UPD}" | grep -q "channel=dev"; then echo "GUNNCHOS_UPDATE_STATE=ok"; else echo "GUNNCHOS_UPDATE_STATE=degraded"; fi
if echo "${FLEET}" | grep -q "services=17"; then echo "GUNNCHOS_FLEET_INVENTORY=ok"; else echo "GUNNCHOS_FLEET_INVENTORY=degraded"; fi
# Package/launch one app via sandbox launch_policy (manifest + policy path).
if [ -f /opt/gunnchos/apps/manifest.json ] && gunnchos-ipc sandbox POST /call "launch_policy=waike" 2>/dev/null | grep -q "isolation="; then
  echo "GUNNCHOS_APP_LAUNCH=ok"
else
  echo "GUNNCHOS_APP_LAUNCH=degraded"
fi
echo "GUNNCHOS_CONT_VI_SEMANTICS=true"
echo "FULL_GUNNCHOS_PLATFORM_DIGITAL_COMPLETE=false"

# Shell + app/game runtime presence checks (before slower restart smoke).
if [ -x /opt/gunnchos/bin/gunnchos-shell ]; then
  /opt/gunnchos/bin/gunnchos-shell --self-test || true
  echo "GUNNCHOS_SHELL=ok"
else
  echo "GUNNCHOS_SHELL=missing"
fi

if [ -f /opt/gunnchos/apps/manifest.json ]; then
  echo "GUNNCHOS_APP_RUNTIME=manifest_present"
  echo "GUNNCHOS_APP_MANIFEST=ok"
else
  echo "GUNNCHOS_APP_RUNTIME=manifest_missing"
  echo "GUNNCHOS_APP_MANIFEST=missing"
fi

if [ -f /opt/gunnchos/games/manifest.json ]; then
  echo "GUNNCHOS_GAME_MANIFEST=ok"
else
  echo "GUNNCHOS_GAME_MANIFEST=missing"
fi

if [ -x /opt/gunnchos/updater/ab_status.sh ]; then
  /opt/gunnchos/updater/ab_status.sh || true
fi

if [ -x /opt/gunnchos/recovery/self_check.sh ]; then
  /opt/gunnchos/recovery/self_check.sh || true
fi

# Restart smoke last (stop/start is the slow path under TCG).
if /opt/gunnchos/services/diagnostics.sh restart >/run/gunnchos-diagnostics-restart.log 2>&1; then
  echo "GUNNCHOS_SERVICE_RESTART=ok"
else
  echo "GUNNCHOS_SERVICE_RESTART=failed"
fi

echo "GUNNCHOS_BOOTLOADER=linux_direct_kernel"
echo "GUNNCHOS_TARGET=qemu-system-aarch64"
# Explicitly withhold full-platform completion while image IPC is mailbox (not host AF_UNIX plane).
echo "FULL_GUNNCHOS_PLATFORM_DIGITAL_COMPLETE=false"
echo "GUNNCHOS_BOOT_MARKER=OK"
echo "GUNNCHOS_BOOT_COMPLETE=true"

# Keep guest alive briefly so QEMU serial capture finishes, then halt.
sleep 2
# Prefer clean poweroff; fall back to busybox poweroff/halt.
ifcommand poweroff && poweroff -f 2>/dev/null || true
ifcommand halt && halt -f 2>/dev/null || true
exit 0
