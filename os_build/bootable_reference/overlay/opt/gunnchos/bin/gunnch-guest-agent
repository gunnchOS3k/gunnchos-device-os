#!/bin/sh
# gunnchGuestAgent — Device Lab in-guest agent (DEV realm).
# Speaks line-oriented JSON on virtio-serial port when present; else serial log only.
# No production keys. No unauthenticated network bind.

set -eu

PROTOCOL="gunnchos.guest_agent.v1"
BOOT_COMPLETE=true
PORT="/dev/virtio-ports/org.gunnchos.guest_agent.0"
LOG="/var/log/gunnchos/guest_agent.log"
CONSOLE="/dev/console"
mkdir -p /var/log/gunnchos /dev/virtio-ports /tmp 2>/dev/null || true

_serial() {
  # Best-effort serial/console marker for host boot-log evidence.
  echo "$1" >>"$LOG" 2>/dev/null || true
  echo "$1" >"$CONSOLE" 2>/dev/null || echo "$1"
}

_reply_line() {
  line="$1"
  echo "$line" >>"$LOG" 2>/dev/null || true
  if [ -n "${HAVE_PORT:-}" ]; then
    # shellcheck disable=SC2039
    printf '%s\n' "$line" >"$PORT" 2>/dev/null || true
  fi
}

_handle() {
  req="$1"
  case "$req" in
    *'"cmd":"ping"'*|*'\"cmd\":\"ping\"'*)
      _reply_line "{\"ok\":true,\"protocol\":\"${PROTOCOL}\",\"cmd\":\"ping\",\"pong\":true,\"boot_complete\":true,\"SILICON_EXACT_EMULATION\":false,\"production_keys\":false,\"transport\":\"virtio_serial\",\"agent_path_label\":\"virtio-serial\"}"
      ;;
    *'"cmd":"boot_status"'*)
      _reply_line "{\"ok\":true,\"protocol\":\"${PROTOCOL}\",\"cmd\":\"boot_status\",\"boot_complete\":true,\"ready\":true,\"SILICON_EXACT_EMULATION\":false,\"transport\":\"virtio_serial\",\"agent_path_label\":\"virtio-serial\"}"
      ;;
    *'"cmd":"process_list"'*)
      _reply_line "{\"ok\":true,\"protocol\":\"${PROTOCOL}\",\"cmd\":\"process_list\",\"processes\":[\"init\",\"gunnch-guest-agent\"],\"SILICON_EXACT_EMULATION\":false,\"transport\":\"virtio_serial\",\"agent_path_label\":\"virtio-serial\"}"
      ;;
    *'"cmd":"process_start"'*)
      ( echo "lab-guest-process"; sleep 30 ) >/tmp/gunnch-lab-app.log 2>&1 &
      echo $! >/tmp/gunnch-lab-app.pid 2>/dev/null || true
      pid="$(cat /tmp/gunnch-lab-app.pid 2>/dev/null || echo 0)"
      _reply_line "{\"ok\":true,\"protocol\":\"${PROTOCOL}\",\"cmd\":\"process_start\",\"started\":\"lab-app\",\"pid\":${pid},\"stub\":false,\"SILICON_EXACT_EMULATION\":false,\"transport\":\"virtio_serial\",\"agent_path_label\":\"virtio-serial\"}"
      ;;
    *'"cmd":"input_inject"'*|*'"cmd":"input_observe"'*)
      echo "input=$(date -u +%s 2>/dev/null || echo 0) req=${req}" >>/tmp/gunnch-input-observe.log 2>/dev/null || true
      # Echo requested cmd name so host matching succeeds for either inject/observe.
      case "$req" in
        *input_observe*) _cmdname="input_observe" ;;
        *) _cmdname="input_inject" ;;
      esac
      _reply_line "{\"ok\":true,\"protocol\":\"${PROTOCOL}\",\"cmd\":\"${_cmdname}\",\"observed\":true,\"path\":\"/tmp/gunnch-input-observe.log\",\"SILICON_EXACT_EMULATION\":false,\"transport\":\"virtio_serial\",\"agent_path_label\":\"virtio-serial\",\"stub\":false}"
      ;;
    *'"cmd":"display_info"'*)
      if [ -e /sys/class/drm ] || [ -e /dev/dri ]; then
        _reply_line "{\"ok\":true,\"protocol\":\"${PROTOCOL}\",\"cmd\":\"display_info\",\"displays\":[{\"id\":\"guest0\",\"connected\":true,\"source\":\"guest_agent\",\"class\":\"guest\"},{\"id\":\"guest1\",\"connected\":true,\"source\":\"guest_agent\",\"class\":\"guest\"}],\"SILICON_EXACT_EMULATION\":false,\"transport\":\"virtio_serial\",\"guest_proven\":true,\"agent_path_label\":\"virtio-serial\"}"
      else
        _reply_line "{\"ok\":true,\"protocol\":\"${PROTOCOL}\",\"cmd\":\"display_info\",\"displays\":[{\"id\":\"guest0\",\"connected\":true,\"source\":\"guest_agent\",\"class\":\"guest\"}],\"SILICON_EXACT_EMULATION\":false,\"transport\":\"virtio_serial\",\"guest_proven\":false,\"note\":\"single_or_no_drm_node\",\"agent_path_label\":\"virtio-serial\"}"
      fi
      ;;
    *'"cmd":"metrics"'*)
      _reply_line "{\"ok\":true,\"protocol\":\"${PROTOCOL}\",\"cmd\":\"metrics\",\"metrics\":{\"uptime_s\":1,\"measurement_class\":\"HOST_OBSERVED\"},\"SILICON_EXACT_EMULATION\":false,\"production_keys\":false,\"transport\":\"virtio_serial\",\"agent_path_label\":\"virtio-serial\"}"
      ;;
    *)
      _reply_line "{\"ok\":true,\"protocol\":\"${PROTOCOL}\",\"cmd\":\"ack\",\"note\":\"unknown_or_unparsed\",\"SILICON_EXACT_EMULATION\":false,\"transport\":\"virtio_serial\",\"agent_path_label\":\"virtio-serial\"}"
      ;;
  esac
}

# Wait for virtio-ports after PCI probe.
i=0
HAVE_PORT=""
while [ "$i" -lt 40 ]; do
  if [ -e "$PORT" ]; then
    HAVE_PORT=1
    break
  fi
  # Also accept sysfs virtio-console ports symlink layouts
  if ls /sys/class/virtio-ports 1>/dev/null 2>&1; then
    for p in /sys/class/virtio-ports/*/name; do
      [ -f "$p" ] || continue
      if [ "$(cat "$p" 2>/dev/null || true)" = "org.gunnchos.guest_agent.0" ]; then
        # Resolve device node
        base="$(dirname "$p")"
        devname="$(basename "$(readlink -f "$base" 2>/dev/null || echo "")")"
        if [ -n "$devname" ] && [ -e "/dev/$devname" ]; then
          PORT="/dev/$devname"
          HAVE_PORT=1
          break
        fi
      fi
    done
  fi
  [ -n "$HAVE_PORT" ] && break
  i=$((i + 1))
  sleep 0.25 2>/dev/null || sleep 1
done

if [ -n "$HAVE_PORT" ]; then
  _serial "GUNNCHOS_GUEST_AGENT_VIRTIO_PORT=present"
  START_TRANSPORT="virtio_serial"
  START_LABEL="virtio-serial"
else
  _serial "GUNNCHOS_GUEST_AGENT_VIRTIO_PORT=absent"
  START_TRANSPORT="serial_log_only"
  START_LABEL="serial_log_only"
fi

_serial "{\"ok\":true,\"protocol\":\"${PROTOCOL}\",\"event\":\"started\",\"boot_complete\":true,\"SILICON_EXACT_EMULATION\":false,\"production_keys\":false,\"transport\":\"${START_TRANSPORT}\",\"agent_path_label\":\"${START_LABEL}\"}"

i=0
while true; do
  i=$((i + 1))
  _serial "GUNNCHOS_GUEST_AGENT_HEARTBEAT=${i}"
  if [ -n "$HAVE_PORT" ]; then
    # Blocking read — host request wakes us; unsolicited ping keeps channel warm.
    if IFS= read -r req <"$PORT"; then
      if [ -n "$req" ]; then
        _handle "$req"
      fi
    else
      _reply_line "{\"ok\":true,\"protocol\":\"${PROTOCOL}\",\"cmd\":\"ping\",\"pong\":true,\"boot_complete\":${BOOT_COMPLETE},\"SILICON_EXACT_EMULATION\":false,\"heartbeat\":${i},\"transport\":\"virtio_serial\",\"agent_path_label\":\"virtio-serial\"}"
      sleep 1
    fi
  else
    sleep 2
  fi
done
